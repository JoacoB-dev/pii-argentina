{
  "name": "pii-argentina",
  "version": "0.1.0",
  "description": "Detecta y anonimiza datos sensibles argentinos (CUIT, CUIL, CBU, CVU, DNI, alias, teléfonos, patentes) antes de mandarlos a una IA. Incluye proxy para OpenAI y Anthropic.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./proxy": "./src/proxy.js"
  },
  "bin": { "pii-argentina": "src/cli.js" },
  "files": ["src", "README.md", "README.en.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=18" },
  "keywords": ["pii", "argentina", "cuit", "cbu", "dni", "anonimizar", "redact", "llm", "openai", "anthropic", "privacy"],
  "author": "Joaquin Alejandro Bobbio",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/JoacoB-dev/pii-argentina" }
}
